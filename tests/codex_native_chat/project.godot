; Engine configuration file.
; Used only for Codex Native Chat smoke tests.
config_version=5

[application]
config/name="Codex Native Chat Smoke Test"
run/main_scene=""

[editor_plugins]
enabled=PackedStringArray("res://addons/codex_native_chat/plugin.cfg")

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
